*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg: #0b1829;
  --surface: #101e30;
  --border: #1c2f46;
  --border-hover: #2e4a6a;
  --text: #e8edf5;
  --muted: #4a6080;
  --subtle: #1a2d45;
  --accent: #fff;
  --tag-bg: #0d1e30;
  --radius: 8px;
}

html { background: var(--bg); color: var(--text); font-family: 'Inter', -apple-system, sans-serif; }

body { min-height: 100vh; position: relative; }

#fractal-bg {
  position: fixed; inset: 0; z-index: 0;
  pointer-events: none;
  background: var(--bg);
}

/* ── Layout ── */
.container { max-width: 680px; margin: 0 auto; padding: 0 24px; position: relative; z-index: 1; }

/* ── Nav ── */
nav {
  position: sticky; top: 0; z-index: 100;
  border-bottom: 1px solid var(--border);
  background: rgba(11,24,41,0.90);
  backdrop-filter: blur(12px);
}
.nav-inner {
  max-width: 680px; margin: 0 auto; padding: 0 24px;
  height: 56px; display: flex; align-items: center; justify-content: space-between;
}
.nav-logo { font-size: 14px; font-weight: 500; color: var(--text); letter-spacing: -0.01em; }
.nav-links { display: flex; gap: 20px; align-items: center; }
.nav-links a {
  font-size: 13px; color: var(--muted); text-decoration: none;
  transition: color 0.15s;
}
.nav-links a:hover { color: var(--text); }

/* ── Hero ── */
.hero { padding: 96px 0 80px; }
.hero-eyebrow {
  font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--muted); margin-bottom: 24px;
}
.hero h1 {
  font-size: clamp(3rem, 8vw, 4.5rem);
  font-weight: 600;
  letter-spacing: -0.04em;
  line-height: 1.0;
  color: var(--accent);
  margin-bottom: 20px;
}
.hero-sub {
  font-size: 16px; color: var(--muted); font-weight: 400;
  line-height: 1.6; max-width: 420px;
}
.hero-links { display: flex; gap: 12px; margin-top: 36px; flex-wrap: wrap; }
.social-btn {
  display: inline-flex; align-items: center; gap: 7px;
  font-size: 13px; font-weight: 400; color: var(--muted);
  border: 1px solid var(--border); border-radius: 6px;
  padding: 7px 13px; text-decoration: none;
  transition: border-color 0.15s, color 0.15s, background 0.15s;
}
.social-btn:hover { border-color: var(--border-hover); color: var(--text); background: var(--surface); }
.social-btn svg { width: 14px; height: 14px; fill: currentColor; flex-shrink: 0; }

/* ── Divider ── */
.divider { border: none; border-top: 1px solid var(--border); margin: 0; }

/* ── Section ── */
section { padding: 64px 0; }
.section-label {
  font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--muted); margin-bottom: 32px;
}
.section-header {
  display: flex; align-items: baseline; justify-content: space-between;
  margin-bottom: 32px;
}
.section-header a {
  font-size: 12px; color: var(--muted); text-decoration: none;
  transition: color 0.15s;
}
.section-header a:hover { color: var(--text); }

/* ── Projects ── */
.projects-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
@media (max-width: 500px) { .projects-grid { grid-template-columns: 1fr; } }

.project-card {
  border: 1px solid var(--border); border-radius: var(--radius);
  padding: 20px; background: var(--surface);
  transition: border-color 0.15s;
  cursor: pointer;
}
.project-card:hover { border-color: var(--border-hover); }
.project-card.placeholder { opacity: 0.4; }
.project-name { font-size: 14px; font-weight: 500; color: var(--text); margin-bottom: 6px; }
.project-desc { font-size: 13px; color: var(--muted); line-height: 1.55; }
.project-tag {
  display: inline-block; margin-top: 14px;
  font-size: 11px; background: var(--tag-bg); border: 1px solid var(--border);
  color: var(--muted); padding: 2px 8px; border-radius: 4px;
  letter-spacing: 0.03em;
}

/* ── Footer ── */
footer {
  padding: 40px 0; border-top: 1px solid var(--border);
  font-size: 12px; color: var(--muted);
  display: flex; justify-content: space-between; align-items: center;
  flex-wrap: wrap; gap: 12px;
}
